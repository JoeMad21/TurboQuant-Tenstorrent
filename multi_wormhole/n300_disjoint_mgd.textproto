# Mesh graph descriptor for tt-run on alpha01: one mesh per n300 card (its two
# chips). The cards are not ethernet-cabled to each other, so the meshes are
# disjoint, like tt-metal's t3k_2x2_disjoint_mesh_graph_descriptor.textproto.
# One instance per rank in rank_bindings.yaml (mesh_id = rank).

mesh_descriptors {
  name: "N300"
  arch: WORMHOLE_B0
  device_topology { dims: [ 1, 2 ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

graph_descriptors {
  name: "CARDS"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "N300" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "N300" mesh_id: 1 } }
  instances { mesh { mesh_descriptor: "N300" mesh_id: 2 } }
  # Disjoint: no connections between cards
}

top_level_instance { graph { graph_descriptor: "CARDS" graph_id: 0 } }
